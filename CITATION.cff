license: CC-BY-NC-SA-4.0
repository-code: "https://github.com/NBDsoftware/deep_cartograph"
url: "https://nbdsoftware.github.io/deep_cartograph/"
keywords:
  - molecular dynamics
  - collective variables
  - machine learning
  - enhanced sampling
  - PLUMED
